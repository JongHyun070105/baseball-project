{
  "name": "diamond-road",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "setup:browsers": "playwright install chromium",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:visual": "playwright test tests/visual --project=chromium",
    "test:performance": "playwright test tests/performance --project=system-chrome",
    "test:assets": "node scripts/check-assets.mjs",
    "verify": "npm run preflight && npm run typecheck && npm run lint && npm run test && npm run test:assets && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/rapier": "2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
